# ---- Application ----
APP_NAME=vision-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Security ----
# Shared secret required in the X-API-Key header on every /api/v1 request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when ENVIRONMENT=production (the API refuses requests without it).
API_KEY=
# Expose /docs, /redoc and /openapi.json (defaults to off in production).
# ENABLE_DOCS=false
# Comma-separated list of allowed origins. "*" is ignored in production.
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL (vision-service own DB: detection jobs + events) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vision
# No default: set a real password (do not commit it).
POSTGRES_PASSWORD=
POSTGRES_DB=vision_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- YOLO11 / detection ----
# Model identifier. Ultralytics auto-downloads official weights (e.g. yolo11n.pt).
# For accurate carton/pallet detection, point this to a model fine-tuned on
# carton + pallet data.
DEFAULT_MODEL_PATH=yolo11n.pt
# Comma-separated class names (lower-cased) counted as cartons by default.
# Per-job targets override this; kept for backward reference.
DEFAULT_CARTON_CLASS_NAMES=carton,box,cardboard box
TRACKER_CONFIG=bytetrack.yaml
CONFIDENCE_THRESHOLD=0.35
DEFAULT_FRAME_SAMPLE_INTERVAL=5
DEFAULT_REPORT_INTERVAL_SECONDS=10
ENABLE_DEBUG_FRAMES=false
# Job inputs are caller-supplied, so both are allowlisted:
#  * a job's file `source` must resolve below one of these directories
ALLOWED_MEDIA_DIRS=media
#  * a job's `model_path` override must resolve below this directory (or be an
#    official Ultralytics weight name such as yolo11n.pt)
ALLOWED_MODEL_DIR=weights
# Allow the simulated demo:// pipeline used by the dashboard's demo button.
ALLOW_DEMO_SOURCES=true

# ---- inventory-service integration ----
INVENTORY_SERVICE_URL=http://localhost:8000
INVENTORY_API_PREFIX=/api/v1
INVENTORY_REQUEST_TIMEOUT_SECONDS=10
# API key sent to inventory-service; falls back to API_KEY when unset.
INVENTORY_API_KEY=
