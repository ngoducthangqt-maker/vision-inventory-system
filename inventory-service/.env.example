# ---- Application ----
APP_NAME=inventory-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Security ----
# Shared secret required in the X-API-Key header on every /api/v1 request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when ENVIRONMENT=production (the API refuses requests without it).
API_KEY=
# Expose /docs, /redoc and /openapi.json (defaults to off in production).
# ENABLE_DOCS=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=inventory
# No default: set a real password (do not commit it).
POSTGRES_PASSWORD=
POSTGRES_DB=inventory_db

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- CORS ----
# Comma-separated list of allowed origins. "*" is ignored in production.
CORS_ORIGINS=http://localhost:3000
